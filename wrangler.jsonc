{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exeed-can-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "CAN_HUB",
        "class_name": "CanHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanHub"]
    }
  ]
}
